

//////////////////////////////////////////////////////////
//
//    ELECTROSTATIC POTENTIAL
//
//////////////////////////////////////////////////////////

load "msh3"
load "gmsh"
load "medit"

mesh3 Th = gmshload3("idc.msh2");

int n1, n2, n3;
real xmin, xmax, ymin, ymax, ax3, zmin, zmax;
string[int] electrodenames = ["center","gate_bottom","gate_top","guard","half_donut_bottom","half_donut_top","reservoir"];
int[int] electrodeid = [10, 8, 7, 11, 6, 5, 9];

int numV = 7;
real[int, int] V(numV, numV);
for (int i = 0; i < numV; i+= 1){
    for (int j = 0; j < numV; j+= 1){
        if (i == j) {V(i, j) = 1.0;}
        else {V(i, j) = 1e-5;}}}

real[int, int] CapacitanceMatrix(numV, numV);
for (int i = 0; i < numV; i+= 1){
    for (int j = 0; j < numV; j+= 1){
        CapacitanceMatrix(i, j) = 0.0;}}

ofstream extract0Ex("Ex_xy.txt");
ofstream extract1Ey("Ey_xy.txt");
ofstream extract2phi("phi_xy.txt");

fespace Vh(Th,P23d);
fespace FunctionRegion(Th,P03d);
real eps = 1e-6;
macro norm [N.x,N.y,N.z] //
macro Grad(u) [dx(u),dy(u),dz(u)] //
macro field(u,x,y,z) [dx(u)(x,y,z),dy(u)(x,y,z),dz(u)(x,y,z)] //
 
Vh u,v;
FunctionRegion dielectric =
                          + 10.5 * (region == 2)
                          + 1.057 * (region == 4)
                          + 1.0 * (region == 3)
                          + 1.0 * (region == 1)
                          ;
for(int k = 0; k < numV; k++){
    problem Electro(u,v,solver=CG) =
                    int3d(Th)(dielectric * Grad(u)' * Grad(v))
                    + on(10,u = V(k,0))
                    + on(8,u = V(k,1))
                    + on(7,u = V(k,2))
                    + on(11,u = V(k,3))
                    + on(6,u = V(k,4))
                    + on(5,u = V(k,5))
                    + on(9,u = V(k,6))
                    ;
    cout << "I'm on iteration " << k + 1 << "/" << numV << endl;
    Electro;
    cout << "calculations are finished, saving data" << endl;
 

//////////////////////////////////////////////////////////
//
//    2D DATA EXTRACTION BLOCK START
//
//////////////////////////////////////////////////////////

    {
    n1 = 101;
    n2 = 101;
    xmin = -5;
    xmax = 5;
    ymin = -5;
    ymax = 5;
    ax3  = 0.62;
    real[int,int] quantity(n1,n2);
    real[int] xList(n1), yList(n2);
 
    for(int i = 0; i < n1; i++){
        real ax1 = xmin + i*(xmax-xmin)/(n1-1);
        xList[i] = ax1;
        for(int j = 0; j < n2; j++){
            real ax2 = ymin + j*(ymax-ymin)/(n2-1);
            yList[j] = ax2;
            quantity(i,j) = dx(u)(ax1,ax2,ax3);}}
 
    extract0Ex << "startDATA " + electrodenames[k] + " ";
    extract0Ex << quantity << endl;
    extract0Ex << "END" << endl;
    if (k == numV - 1){
        extract0Ex << "startXY xlist ";
        extract0Ex << xList << endl;
        extract0Ex << "END" << endl;
        extract0Ex << "startXY ylist ";
        extract0Ex << yList << endl;
        extract0Ex << "END" << endl;}
    }

//////////////////////////////////////////////////////////
//
//    2D DATA EXTRACTION BLOCK END
//
//////////////////////////////////////////////////////////


//////////////////////////////////////////////////////////
//
//    2D DATA EXTRACTION BLOCK START
//
//////////////////////////////////////////////////////////

    {
    n1 = 101;
    n2 = 101;
    xmin = -5;
    xmax = 5;
    ymin = -5;
    ymax = 5;
    ax3  = 0.62;
    real[int,int] quantity(n1,n2);
    real[int] xList(n1), yList(n2);
 
    for(int i = 0; i < n1; i++){
        real ax1 = xmin + i*(xmax-xmin)/(n1-1);
        xList[i] = ax1;
        for(int j = 0; j < n2; j++){
            real ax2 = ymin + j*(ymax-ymin)/(n2-1);
            yList[j] = ax2;
            quantity(i,j) = dy(u)(ax1,ax2,ax3);}}
 
    extract1Ey << "startDATA " + electrodenames[k] + " ";
    extract1Ey << quantity << endl;
    extract1Ey << "END" << endl;
    if (k == numV - 1){
        extract1Ey << "startXY xlist ";
        extract1Ey << xList << endl;
        extract1Ey << "END" << endl;
        extract1Ey << "startXY ylist ";
        extract1Ey << yList << endl;
        extract1Ey << "END" << endl;}
    }

//////////////////////////////////////////////////////////
//
//    2D DATA EXTRACTION BLOCK END
//
//////////////////////////////////////////////////////////


//////////////////////////////////////////////////////////
//
//    2D DATA EXTRACTION BLOCK START
//
//////////////////////////////////////////////////////////

    {
    n1 = 501;
    n2 = 501;
    xmin = -5;
    xmax = 5;
    ymin = -5;
    ymax = 5;
    ax3  = 0.62;
    real[int,int] quantity(n1,n2);
    real[int] xList(n1), yList(n2);
 
    for(int i = 0; i < n1; i++){
        real ax1 = xmin + i*(xmax-xmin)/(n1-1);
        xList[i] = ax1;
        for(int j = 0; j < n2; j++){
            real ax2 = ymin + j*(ymax-ymin)/(n2-1);
            yList[j] = ax2;
            quantity(i,j) = u(ax1,ax2,ax3);}}
 
    extract2phi << "startDATA " + electrodenames[k] + " ";
    extract2phi << quantity << endl;
    extract2phi << "END" << endl;
    if (k == numV - 1){
        extract2phi << "startXY xlist ";
        extract2phi << xList << endl;
        extract2phi << "END" << endl;
        extract2phi << "startXY ylist ";
        extract2phi << yList << endl;
        extract2phi << "END" << endl;}
    }

